<section id="groups-panel" class="bg-white border-e-2 border-slate-100 w-80">
  <div class="title flex justify-between align-middle text-xl font-extrabold p-7 border-b-2 border-slate-100">
    <h1>Groups</h1>
    <i id="create-group"
      class="fa-solid fa-plus cursor-pointer p-1 bg-indigo-500 hover:bg-indigo-600 text-white rounded-full duration-300"></i>
  </div>
  <div id="groups-list" class="p-4 text-sm">
    <div id="groups-wrapper">
      <% for (const group of groups) { %>
        <a href="/home/groups/<%= group.id %>">
          <div class="chat p-3 rounded-lg hover:bg-indigo-50 duration-300">
            <img class="avatar" src="https://i.pinimg.com/736x/fa/47/30/fa4730338dabbd71947d73239891f059.jpg" alt="/">
            <h3 class="name font-semibold text-base">
              <%= group.name %>
            </h3>
            <p class="time text-slate-400 font-semibold"></p>
            <p class="preview text-slate-500">
              <%= group.lastMessage %>
            </p>
          </div>
        </a>
        <% } %>
    </div>
  </div>
</section>