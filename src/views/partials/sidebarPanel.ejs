<section id="sidebar" class="p-4 mr-8 bg-white shadow-md flex flex-col justify-between">
  <div class="platform-icons mt-3 flex flex-col justify-start gap-6">
    <a href="/home" class="text-center"><i class="fa-solid fa-message fa-lg <%= sidebar == 1 ? " text-indigo-500"
        : "hover:text-indigo-500 duration-300" %> "></i></a>
    <a href="/home/groups" class="text-center"><i class="fa-solid fa-users fa-lg <%= sidebar == 2 ? " text-indigo-500"
        : "hover:text-indigo-500 duration-300" %> "></i></a>
    <a href="/home/logout" class="text-center"><i
        class="fa-solid fa-arrow-right-from-bracket fa-lg hover:text-indigo-500 duration-300"></i></a>
  </div>
  <img src="<%= user.avatar %>" alt="user-avatar" class="w-12 h-12 rounded-full">
</section>